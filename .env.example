# Copy to .env and replace every placeholder. These are examples, not real credentials.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-me
DATABASE_URL=postgresql+psycopg://nexus:change-me@db:5432/nexus
REDIS_URL=redis://redis:6379/0

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated CORS allowlist (no wildcards in production)
CORS_ORIGINS=http://localhost:5173

GITHUB_API_BASE=https://api.github.com

# AI is optional. "none" keeps the deterministic engine only.
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

MCP_API_BASE_URL=http://backend:8000
MCP_SERVICE_TOKEN=

POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus

LOG_LEVEL=INFO
