# Copy to .env and replace every placeholder. These are examples, not real credentials.
# Generate APP_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
APP_SECRET_KEY=replace-me

# PostgreSQL for Compose. Development without Docker can use sqlite:///./nexus_dev.sqlite3.
DATABASE_URL=postgresql+psycopg://nexus:change-me@db:5432/nexus

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Comma-separated allowlist; wildcards are rejected in production.
CORS_ORIGINS=http://localhost:5173

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=nexus_session
CSRF_COOKIE_NAME=nexus_csrf
SESSION_TTL_HOURS=168
# Leave empty to default to secure cookies in production only.
COOKIE_SECURE=

# --- Rate limits (per client IP; in-process, single replica) -----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10

# --- GitHub -----------------------------------------------------------------
GITHUB_API_BASE=https://api.github.com
GITHUB_RAW_BASE=https://raw.githubusercontent.com
# Optional: a token raises rate limits. Never required for public repositories.
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_RETRIES=2

# --- Ingestion limits -------------------------------------------------------
MAX_INDEX_FILES=400
MAX_FILE_BYTES=262144
MAX_TOTAL_BYTES=20971520
MAX_SYMBOLS_PER_FILE=400
INDEX_FETCH_CONCURRENCY=4

# --- Jobs -------------------------------------------------------------------
# inline = background thread in the API (development); worker = separate process.
JOB_EXECUTION_MODE=worker
JOB_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=2

# --- AI (optional; deterministic analysis is always available) --------------
AI_PROVIDER=none
AI_BASE_URL=http://localhost:11434
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45

# --- MCP / Compose ----------------------------------------------------------
# MCP_SERVICE_TOKEN is a personal API token created in NEXUS Settings.
MCP_SERVICE_TOKEN=
MCP_ALLOW_WRITES=0

POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus

LOG_LEVEL=INFO

# Redis is not used by the current durable database job queue.
